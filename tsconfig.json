{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "src/screens/auth/ForgotPassword.js",
    "src/screens/auth/LoginScreen.js",
    "src/screens/auth/RegisterScreen.js",
    "src/app/index.jsx"
, "src/components/ui/collapsible.js"  ]
}
